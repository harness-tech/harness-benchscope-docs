---
import Mesh from './Mesh.astro'

interface Props {
  lang: 'zh' | 'en'
  docsHref: string
  ico: (name: string, size?: number) => string
}
const { lang, ico } = Astro.props
const isEn = lang === 'en'

const aTitle = isEn ? 'Accuracy' : '精度'
const aLead = isEn ? 'Evaluate model output quality against baselines, online or offline, with per-sample traceability.' : '对标基线评估模型输出质量，在线或离线，每个样本可溯源。'

const accCells = [
  { i: 'target', t: isEn ? 'Create Accuracy Task' : '创建精度任务', d: isEn ? 'Pick a dataset with token warnings.' : '选择数据集，附带 Token 词元预警。' },
  { i: 'globe', t: isEn ? 'Serving Mode' : '服务模式', d: isEn ? 'Online test of a deployed OpenAI-compatible service.' : '对已部署的 OpenAI 兼容服务在线测试。' },
  { i: 'chart', t: isEn ? 'Accuracy Analysis' : '精度分析', d: isEn ? 'Official-model accuracy comparison.' : '官方模型精度对标分析。' },
  { i: 'database', t: isEn ? 'Offline Mode' : '离线模式', d: isEn ? 'Native accuracy test of local weights.' : '对本地权重进行原生精度测试。' },
]
---

<section id="accuracy" class="screen sec">
  <Mesh density={16} className="screen-mesh" />
  <div class="sec-in">
    <div class="sec-panel">
      <div class="sec-panel-head">
        <p class="eyebrow">{aTitle}</p>
        <h2 class="sec-title">{aTitle}</h2>
      </div>
      <div class="agrid">
        <div class="acol-main flowcell">
          <Mesh ripple density={22} className="row-mesh" />
          <div class="row-lead-in">
            <h3 class="pan-title">{isEn ? 'Accuracy Testing' : '精度测试'}</h3>
            <p class="pan-lead">{aLead}</p>
            <div class="acc-datasets">
              {['MMLU', 'GSM8K', 'C-Eval', 'HumanEval', 'MATH', 'BBH', 'ARC', 'HellaSwag'].map((ds) => (
                <span class="acc-tag">{ds}</span>
              ))}
            </div>
          </div>
        </div>
        <div class="acol">
          {accCells.slice(0, 2).map((c) => (
            <div class="fcell flowcell small">
              <div class="virt av" aria-hidden="true"></div>
              <div class="ficon ficon-lg"><Fragment set:html={ico(c.i, 28)} /></div>
              <h3 class="fct">{c.t}</h3>
              <p class="fcd">{c.d}</p>
            </div>
          ))}
        </div>
        <div class="acol">
          {accCells.slice(2, 4).map((c) => (
            <div class="fcell flowcell small">
              <div class="virt av" aria-hidden="true"></div>
              <div class="ficon ficon-lg"><Fragment set:html={ico(c.i, 28)} /></div>
              <h3 class="fct">{c.t}</h3>
              <p class="fcd">{c.d}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ── 屏4 精度 ── */
  .agrid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 12px;
    flex: 1;
    min-height: 0;
  }
  .acol-main {
    grid-row: 1 / 3;  /* 占满 2 行 */
    padding: 24px; position: relative; background: var(--bg-surface); border: 1px solid var(--line);
    display: flex; flex-direction: column; justify-content: center; overflow: hidden;
    min-height: 0;
  }
  .row-lead-in { position: relative; z-index: 2; }
  .acol {
    grid-row: 1 / 3;  /* 跨 2 行，填满右侧高度 */
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 12px;
    min-height: 0;
  }
  .fcell.small {
    overflow: hidden; display: flex; flex-direction: column; justify-content: center;
  }
  .ficon-lg { font-size: 28px; }
  .ficon-lg svg { width: 28px; height: 28px; }

  /* 数据集 Tags */
  .acc-datasets {
    display: flex; flex-wrap: wrap; gap: 6px;
    margin-top: 14px;
  }
  .acc-tag {
    font: 600 10px var(--font-mono); letter-spacing: .03em;
    color: var(--text-2); background: var(--bg-inset);
    border: 1px solid var(--line); padding: 3px 8px;
    transition: color .16s, border-color .16s;
  }
  .acol-main:hover .acc-tag { border-color: var(--gold-line); color: var(--gold-text); }

  @media (max-width: 1000px) { .agrid { grid-template-columns: 1fr; } .acol { grid-template-columns: 1fr 1fr; grid-template-rows: auto; } }
  @media (max-width: 720px) { .acol { grid-template-columns: 1fr; } }
</style>
