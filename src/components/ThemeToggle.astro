---
const isDocs = Astro.url ? Astro.url.pathname.includes('/docs/') : false
const label = true
---
<button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle theme">
  <!-- 月亮：silver 主题（点击切回黑） -->
  <svg class="ic-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
  <!-- 太阳：black 主题（点击切到银） -->
  <svg class="ic-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
</button>

<script>
  const btn = document.getElementById('themeToggle')
  btn?.addEventListener('click', () => {
    const root = document.documentElement
    const next = root.dataset.theme === 'silver' ? 'black' : 'silver'
    root.dataset.theme = next
    try { localStorage.setItem('bs-theme', next) } catch {}
  })
</script>

<style>
  .ic-sun, .ic-moon { transition: opacity var(--dur-ui) var(--ease-out); }
  :root[data-theme='black'] .ic-sun { display: block; }
  :root[data-theme='black'] .ic-moon { display: none; }
  :root[data-theme='silver'] .ic-moon { display: block; }
  :root[data-theme='silver'] .ic-sun { display: none; }
</style>
