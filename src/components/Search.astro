---
import MiniSearch from 'minisearch'

interface Props { lang: 'zh' | 'en' }
const { lang } = Astro.props
const placeholder = lang === 'zh' ? '搜索文档…' : 'Search docs…'
const noResult = lang === 'zh' ? '无结果' : 'No results'
---

<div class="search-wrap" data-lang={lang} data-noresult={noResult}>
  <div class="search-box" id="searchBox">
    <span class="search-ic" id="searchIc" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
    </span>
    <input id="searchInput" class="search-input" type="text" placeholder={placeholder} autocomplete="off" aria-label={placeholder} />
  </div>
  <div class="search-panel" id="searchPanel" hidden>
    <ul id="searchResults" class="search-results"></ul>
  </div>
</div>

<script>
  import MiniSearch from 'minisearch'

  const wrap = document.querySelector<HTMLElement>('.search-wrap')
  const input = document.getElementById('searchInput') as HTMLInputElement
  const icon = document.getElementById('searchIc')
  const panel = document.getElementById('searchPanel')
  const results = document.getElementById('searchResults')
  const lang = wrap?.dataset.lang || 'zh'
  const noResult = wrap?.dataset.noresult || '无结果'

  if (input && panel) {
    const ms = new MiniSearch({
      fields: ['title', 'body'],
      storeFields: ['title', 'id', 'body'],
      searchOptions: { prefix: true, fuzzy: 0.2, boost: { title: 2 } },
    })
    let ready = false
    let activeHref: string | null = null

    async function ensureIndex() {
      if (ready) return
      try {
        const res = await fetch('/search-index.json')
        const data = await res.json()
        ms.addAll(data.entries.filter((e: any) => e.lang === lang))
        ready = true
      } catch {}
    }

    function open() { panel.hidden = false; activeHref = null }
    function close() {
      panel.hidden = true
      activeHref = null
    }
    function syncIc() {
      // 有输入 → 图标金色可用态
      const has = input.value.trim().length > 0
      icon?.classList.toggle('has', has)
    }

    // 图标状态：聚焦 / 有输入 时金色
    input.addEventListener('focus', () => open())
    input.addEventListener('input', () => { syncIc(); open(); run() })
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { close(); input.blur(); }
      if (e.key === 'Enter' && activeHref) { location.href = activeHref }
    })
    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('.search-wrap')) close()
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== input) { e.preventDefault(); input.focus() }
    })

    function run() {
      const q = input.value.trim()
      if (!q) { results!.innerHTML = ''; close(); return }
      ensureIndex()
      const hits = ms.search(q, { prefix: true, fuzzy: 0.2 })
      if (hits.length) activeHref = hits[0].id
      results!.innerHTML = hits
        .slice(0, 10)
        .map((h: any) => `<li><a href="${h.id}" data-href="${h.id}"><span class="r-title">${h.title}</span><span class="r-body">${(h.body || '').trim().slice(0, 90)}</span></a></li>`)
        .join('') || `<li class="empty">${noResult}</li>`
      // 结果导航
      results!.querySelectorAll<HTMLAnchorElement>('li a').forEach((a) => {
        a.addEventListener('mousedown', (e) => e.preventDefault())
        a.addEventListener('click', (e) => { location.href = a.getAttribute('data-href') || a.href })
      })
    }
  }
</script>

<style>
  .search-wrap { position: relative; width: 180px; }
  .search-box {
    display: flex; align-items: center; gap: 7px; height: 100%;
    color: var(--text-3);
  }
  .search-ic { display: inline-flex; color: var(--text-3); transition: color .15s; flex-shrink: 0; }
  .search-ic.has, .search-box:focus-within .search-ic { color: var(--gold-text); }
  .search-input {
    flex: 1; min-width: 0; height: 100%; background: transparent; border: 0; outline: 0;
    color: var(--text-1); font: 13px/1.4 var(--font-body);
  }
  .search-input::placeholder { color: var(--text-3); }
  .search-panel {
    position: absolute; top: calc(100% + 8px); left: 0; right: 0; z-index: 210;
    background: var(--bg-surface); border: 1px solid var(--line-strong);
    border-radius: 12px; box-shadow: var(--shadow-lg); overflow: hidden;
  }
  .search-panel[hidden] { display: none; }
  .search-results { max-height: 320px; overflow: auto; padding: 6px; list-style: none; }
  .search-results li a {
    display: block; padding: 8px 10px; border-radius: 7px;
    color: var(--text-2); font-size: 13px; text-decoration: none;
  }
  .search-results li a:hover { background: var(--bs-gold-soft); }
  .search-results .r-title { display: block; color: var(--text-1); font-weight: 600; margin-bottom: 2px; }
  .search-results .r-body { display: block; color: var(--text-3); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .search-results li.empty { padding: 12px 10px; color: var(--text-3); font-size: 13px; }
</style>
