---
interface Props {
  ripple?: boolean
  streams?: boolean
  density?: number
  className?: string
}
const { ripple = false, streams = false, density = 14, className = '' } = Astro.props
const d = JSON.stringify({ ripple, streams, density })
---
<div class={"mesh " + className} data-cfg={d} aria-hidden="true">
  <canvas class="mesh-canvas"></canvas>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.mesh[data-cfg]').forEach((root) => {
    const cfg = JSON.parse(root.dataset.cfg || '{}')
    const canvas = root.querySelector('.mesh-canvas') as HTMLCanvasElement
    if (!canvas) return

    const dpr = devicePixelRatio
    let w = 0, h = 0, cols = 0, rows = 0, cw = 0, ch = 0
    let mouse = { x: -9999, y: -9999 }
    let hovering = false
    let animId = 0

    interface Stream { x: number; y: number; len: number; speed: number; horiz: boolean; alpha: number; wobble: number; wobbleSpeed: number; wobblePhase: number }
    let streams: Stream[] = []

    function resize() {
      w = root.clientWidth
      h = root.clientHeight
      if (w < 2 || h < 2) return
      canvas.width = w * dpr
      canvas.height = h * dpr
      canvas.style.width = w + 'px'
      canvas.style.height = h + 'px'

      const gridSize = 34
      cols = Math.round(w / gridSize)
      rows = Math.round(h / gridSize)
      cw = gridSize
      ch = gridSize

      if (cfg.streams) {
        streams = []
        const count = Math.min(10, Math.max(4, Math.round((w + h) / 400)))
        for (let i = 0; i < count; i++) {
          const horiz = Math.random() > 0.5
          streams.push({
            x: horiz ? -0.3 : Math.round(Math.random() * cols) * cw,
            y: horiz ? Math.round(Math.random() * rows) * ch : -0.3,
            len: (horiz ? w : h) * (0.1 + Math.random() * 0.3),
            speed: 30 + Math.random() * 100,
            horiz,
            alpha: 0.2 + Math.random() * 0.4,
            wobble: Math.random() * 3,
            wobbleSpeed: 0.5 + Math.random() * 2,
            wobblePhase: Math.random() * Math.PI * 2,
          })
        }
      }
    }

    const section = root.closest('.screen') || root
    section.addEventListener('mousemove', (e) => {
      const rect = root.getBoundingClientRect()
      mouse.x = e.clientX - rect.left
      mouse.y = e.clientY - rect.top
      hovering = true
    })
    section.addEventListener('mouseleave', () => { hovering = false })

    // 变形函数：给定网格线上的一个点，返回偏移量
    const RADIUS_FACTOR = 6
    const STRENGTH = 6

    function deformOffset(px: number, py: number, elapsed: number): [number, number] {
      if (!hovering) return [0, 0]
      const radius = Math.max(cw, ch) * RADIUS_FACTOR
      const dx = px - mouse.x
      const dy = py - mouse.y
      const dist = Math.hypot(dx, dy)
      const falloff = Math.max(0, 1 - dist / radius)
      if (falloff < 0.01) return [0, 0]
      const wave = Math.sin((px + py) * 0.04 + elapsed * 3) * falloff * STRENGTH
      const angle = Math.atan2(dy, dx)
      return [wave * Math.cos(angle), wave * Math.sin(angle)]
    }

    function draw(ts: number) {
      if (w < 2 || h < 2) { animId = requestAnimationFrame(draw); return }
      const ctx = canvas.getContext('2d')!
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      ctx.clearRect(0, 0, w, h)

      const elapsed = ts / 1000
      const radius = Math.max(cw, ch) * RADIUS_FACTOR

      ctx.lineWidth = 1
      ctx.lineCap = 'round'

      // ── 垂直网格线（变形）──
      for (let c = 0; c <= cols; c++) {
        const baseX = c * cw
        const distToMouseX = hovering ? Math.abs(baseX - mouse.x) : radius + 1
        const influenceX = Math.max(0, 1 - distToMouseX / radius)
        ctx.strokeStyle = `rgba(214,177,90,${(0.08 + influenceX * 0.18).toFixed(3)})`
        ctx.beginPath()
        for (let y = 0; y <= h; y += 3) {
          const [ox] = deformOffset(baseX, y, elapsed)
          const px = baseX + ox
          if (y === 0) ctx.moveTo(px, y)
          else ctx.lineTo(px, y)
        }
        ctx.stroke()
      }

      // ── 水平网格线（变形）──
      for (let r = 0; r <= rows; r++) {
        const baseY = r * ch
        const distToMouseY = hovering ? Math.abs(baseY - mouse.y) : radius + 1
        const influenceY = Math.max(0, 1 - distToMouseY / radius)
        ctx.strokeStyle = `rgba(214,177,90,${(0.08 + influenceY * 0.18).toFixed(3)})`
        ctx.beginPath()
        for (let x = 0; x <= w; x += 3) {
          const [, oy] = deformOffset(x, baseY, elapsed)
          const py = baseY + oy
          if (x === 0) ctx.moveTo(x, py)
          else ctx.lineTo(x, py)
        }
        ctx.stroke()
      }

      // ── 流光（沿变形后的网格线移动）──
      if (cfg.streams) {
        for (const s of streams) {
          if (s.horiz) {
            s.x += s.speed * 0.016
            if (s.x > w + s.len) { s.x = -s.len; s.y = Math.round(Math.random() * rows) * ch }

            // 流光路径：沿水平网格线，应用变形
            const segLen = 4
            const segs = Math.ceil(s.len / segLen)
            const grad = ctx.createLinearGradient(s.x, 0, s.x + s.len, 0)
            grad.addColorStop(0, 'rgba(214,177,90,0)')
            grad.addColorStop(0.15, `rgba(232,200,118,${(s.alpha * 0.4).toFixed(2)})`)
            grad.addColorStop(0.4, `rgba(232,200,118,${s.alpha.toFixed(2)})`)
            grad.addColorStop(0.7, `rgba(214,177,90,${(s.alpha * 0.6).toFixed(2)})`)
            grad.addColorStop(1, 'rgba(214,177,90,0)')
            ctx.strokeStyle = grad
            ctx.lineWidth = 1.5
            ctx.shadowColor = 'rgba(214,177,90,0.35)'
            ctx.shadowBlur = 8
            ctx.beginPath()
            for (let i = 0; i <= segs; i++) {
              const x = s.x + i * segLen
              const [, oy] = deformOffset(x, s.y, elapsed)
              const py = s.y + oy
              if (i === 0) ctx.moveTo(x, py)
              else ctx.lineTo(x, py)
            }
            ctx.stroke()
            ctx.shadowBlur = 0
          } else {
            s.y += s.speed * 0.016
            if (s.y > h + s.len) { s.y = -s.len; s.x = Math.round(Math.random() * cols) * cw }

            const segLen = 4
            const segs = Math.ceil(s.len / segLen)
            const grad = ctx.createLinearGradient(0, s.y, 0, s.y + s.len)
            grad.addColorStop(0, 'rgba(214,177,90,0)')
            grad.addColorStop(0.15, `rgba(232,200,118,${(s.alpha * 0.4).toFixed(2)})`)
            grad.addColorStop(0.4, `rgba(232,200,118,${s.alpha.toFixed(2)})`)
            grad.addColorStop(0.7, `rgba(214,177,90,${(s.alpha * 0.6).toFixed(2)})`)
            grad.addColorStop(1, 'rgba(214,177,90,0)')
            ctx.strokeStyle = grad
            ctx.lineWidth = 1.5
            ctx.shadowColor = 'rgba(214,177,90,0.35)'
            ctx.shadowBlur = 8
            ctx.beginPath()
            for (let i = 0; i <= segs; i++) {
              const y = s.y + i * segLen
              const [ox] = deformOffset(s.x, y, elapsed)
              const px = s.x + ox
              if (i === 0) ctx.moveTo(px, y)
              else ctx.lineTo(px, y)
            }
            ctx.stroke()
            ctx.shadowBlur = 0
          }
        }
      }

      animId = requestAnimationFrame(draw)
    }

    resize()
    window.addEventListener('resize', resize)
    animId = requestAnimationFrame(draw)
  })
</script>

<style>
  .mesh { position: absolute; inset: 0; overflow: hidden; z-index: 0; background: var(--bg); }
  .mesh-canvas { position: absolute; inset: 0; z-index: 0; }
</style>
